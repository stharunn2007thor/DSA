class Solution:
    def numSubarraysWithSum(self, nums: list[int], goal: int) -> int:

        prefix_sum = 0
        count = 0
        freq = {0:1}
        for i in range(len(nums)):
            prefix_sum+= nums[i]
            needed = prefix_sum - goal

            if needed in freq:
                count+= freq[needed]
            
            freq[prefix_sum] = freq.get(prefix_sum,0)+1
        return count

