class Solution:
    def findMaxLength(self, nums: List[int]) -> int:
        prefix = 0
        max_length = 0
        freq = {0:-1}

        for i in range (len(nums)):
            if nums[i] == 0:
                prefix-=1

            else:
                prefix+=1

            if prefix in freq:
                length = i-freq[prefix]
                max_length = max(length, max_length)
            else:
                freq[prefix]=i

        return max_length


            
